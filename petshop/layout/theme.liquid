<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#faf8f5">

    <title>{{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'css/global.css' | asset_url }}">
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a href="#main-content" class="skip-link">Pular para o conteúdo</a>

    <header class="site-header" role="banner">
      {% comment %} Header e navegação serão implementados na Fase 3 {% endcomment %}
    </header>

    <main id="main-content" class="site-main" role="main">
      {{ content_for_layout }}
    </main>

    <footer class="site-footer" role="contentinfo">
      {% comment %} Rodapé será implementado na Fase 4 {% endcomment %}
    </footer>

    <script src="{{ 'js/global.js' | asset_url }}" defer></script>
  </body>
</html>