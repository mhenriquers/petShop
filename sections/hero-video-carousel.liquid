{{ 'hero-video-carousel.css' | asset_url | stylesheet_tag }}

<section
  id="HeroVideoCarousel-{{ section.id }}"
  class="hero-video-carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="hero-video-carousel__media">
    {% for block in section.blocks %}
      <div
        class="hero-video-carousel__slide{% if forloop.first %} is-active{% endif %}"
        data-hero-slide
        data-slide-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.video_asset != blank %}
          <video
            class="hero-video-carousel__video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="{{ block.settings.heading | escape }}"
          >
            <source
              src="{{ block.settings.video_asset | asset_url }}"
              type="video/mp4"
            >
          </video>
        {% else %}
          <div class="hero-video-carousel__placeholder">
            Adicione o nome do vídeo em assets.
          </div>
        {% endif %}

        <div class="hero-video-carousel__overlay"></div>

        <div class="hero-video-carousel__content">
          {% if block.settings.eyebrow != blank %}
            <p class="hero-video-carousel__eyebrow">
              {{ block.settings.eyebrow | escape }}
            </p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h1 class="hero-video-carousel__heading">
              {{ block.settings.heading | escape }}
            </h1>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="hero-video-carousel__text">
              {{ block.settings.text }}
            </div>
          {% endif %}

          {% if block.settings.button_label != blank and block.settings.button_link != blank %}
            <a class="hero-video-carousel__button" href="{{ block.settings.button_link }}">
              {{ block.settings.button_label | escape }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="hero-video-carousel__controls">
      <button
        type="button"
        class="hero-video-carousel__arrow hero-video-carousel__arrow--previous"
        data-hero-previous
        aria-label="Vídeo anterior"
      >&#8592;</button>

      <div class="hero-video-carousel__dots" role="tablist">
        {% for block in section.blocks %}
          <button
            type="button"
            class="hero-video-carousel__dot{% if forloop.first %} is-active{% endif %}"
            data-hero-dot="{{ forloop.index0 }}"
            role="tab"
            aria-label="Ir para o vídeo {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {% endfor %}
      </div>

      <button
        type="button"
        class="hero-video-carousel__arrow hero-video-carousel__arrow--next"
        data-hero-next
        aria-label="Próximo vídeo"
      >&#8594;</button>
    </div>
  {% endif %}
</section>

<script src="{{ 'hero-video-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Hero com vídeos",
  "tag": "section",
  "class": "section-hero-video-carousel",
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Descrição da seção",
      "default": "Apresentação da coleção"
    }
  ],
  "blocks": [
    {
      "type": "video_slide",
      "name": "Vídeo",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "video_asset",
          "label": "Nome do vídeo em assets",
          "info": "Nome exato do arquivo, com extensão. Exemplo: husky.mp4"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Texto superior",
          "default": "Coleção em destaque"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Peças feitas para acompanhar cada momento"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto de apoio",
          "default": "<p>Design, conforto e materiais escolhidos com intenção.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão",
          "default": "Explorar coleção"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link do botão"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero com vídeos",
      "blocks": [
        { "type": "video_slide" },
        { "type": "video_slide" },
        { "type": "video_slide" }
      ]
    }
  ]
}
{% endschema %}