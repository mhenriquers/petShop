{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<h1>{{ collection.title }}</h1>

{% if collection.description != blank %}
  <div class="collection-description">
    {{ collection.description }}
  </div>
{% endif %}

{%- comment -%} Detecta se há filtros ativos para diferenciar os estados vazios {%- endcomment -%}
{%- assign has_active_filters = false -%}
{%- if collection.filters != blank -%}
  {%- for filter in collection.filters -%}
    {%- if filter.type == 'price_range' -%}
      {%- if filter.min_value.value or filter.max_value.value -%}
        {%- assign has_active_filters = true -%}
      {%- endif -%}
    {%- else -%}
      {%- for filter_value in filter.values -%}
        {%- if filter_value.active -%}
          {%- assign has_active_filters = true -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% paginate collection.products by 20 %}
  <div class="collection-layout">

    {%- comment -%} Filtros — renderiza somente o que está configurado no admin {%- endcomment -%}
    {%- if collection.filters != blank -%}
      <aside class="collection-filters">
        <details class="collection-filters__drawer">
          <summary class="collection-filters__summary">Filtros</summary>

          <form method="get" action="{{ collection.url }}" class="collection-filters__form">
            <input
              type="hidden"
              name="sort_by"
              value="{{ collection.sort_by | default: collection.default_sort_by }}"
            >

            {%- for filter in collection.filters -%}
              {%- case filter.type -%}

                {%- when 'list' or 'boolean' -%}
                  <fieldset class="collection-filters__group">
                    <legend class="collection-filters__label">{{ filter.label }}</legend>
                    {%- for filter_value in filter.values -%}
                      <label class="collection-filters__option">
                        <input
                          type="checkbox"
                          name="{{ filter_value.param_name }}"
                          value="{{ filter_value.value }}"
                          {% if filter_value.active %}checked{% endif %}
                          {% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
                        >
                        <span>{{ filter_value.label }}{% if filter_value.count > 0 %} ({{ filter_value.count }}){% endif %}</span>
                      </label>
                    {%- endfor -%}
                  </fieldset>

                {%- when 'price_range' -%}
                  <fieldset class="collection-filters__group">
                    <legend class="collection-filters__label">{{ filter.label }}</legend>
                    <div class="collection-filters__price">
                      <label class="collection-filters__price-field">
                        <span>Mín</span>
                        <input
                          type="number"
                          inputmode="numeric"
                          name="{{ filter.min_value.param_name }}"
                          value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          placeholder="0"
                        >
                      </label>
                      <label class="collection-filters__price-field">
                        <span>Máx</span>
                        <input
                          type="number"
                          inputmode="numeric"
                          name="{{ filter.max_value.param_name }}"
                          value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                        >
                      </label>
                    </div>
                  </fieldset>

              {%- endcase -%}
            {%- endfor -%}

            <div class="collection-filters__actions">
              <button type="submit" class="collection-filters__apply">Aplicar filtros</button>
              <a href="{{ collection.url }}" class="collection-filters__clear">Limpar</a>
            </div>
          </form>
        </details>
      </aside>
    {%- endif -%}

    <div class="collection-main">

      {%- comment -%} Ordenação — preserva os filtros ativos em campos ocultos {%- endcomment -%}
      {%- if collection.sort_options != blank -%}
        <div class="collection-toolbar">
          <p class="collection-count">
            {{ paginate.items }}
            {% if paginate.items == 1 %}peça{% else %}peças{% endif %}
          </p>
          <form method="get" action="{{ collection.url }}" class="collection-sort">
            {%- if collection.filters != blank -%}
              {%- for filter in collection.filters -%}
                {%- if filter.type == 'list' or filter.type == 'boolean' -%}
                  {%- for filter_value in filter.values -%}
                    {%- if filter_value.active -%}
                      <input type="hidden" name="{{ filter_value.param_name }}" value="{{ filter_value.value }}">
                    {%- endif -%}
                  {%- endfor -%}
                {%- elsif filter.type == 'price_range' -%}
                  {%- if filter.min_value.value -%}
                    <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">
                  {%- endif -%}
                  {%- if filter.max_value.value -%}
                    <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            <label class="collection-sort__label" for="sort-by">
              <span class="collection-sort__text">Ordenar por</span>
              <select id="sort-by" name="sort_by" class="collection-sort__select">
                {%- for option in collection.sort_options -%}
                  <option
                    value="{{ option.value }}"
                    {% if option.value == collection.sort_by %}selected{% endif %}
                  >
                    {{ option.name }}
                  </option>
                {%- endfor -%}
              </select>
            </label>
            <button type="submit" class="collection-sort__submit">Ordenar</button>
          </form>
        </div>
      {%- endif -%}

      {%- comment -%} Resumo dos filtros ativos, com remoção individual {%- endcomment -%}
      {%- if collection.filters != blank -%}
        <div class="collection-active">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'list' or filter.type == 'boolean' -%}
              {%- for filter_value in filter.values -%}
                {%- if filter_value.active -%}
                  <a class="collection-active__pill" href="{{ filter_value.url_to_remove }}">
                    {{ filter_value.label }} <span aria-hidden="true">×</span>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="collection-products">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          <div class="collection-empty">
            {%- if has_active_filters -%}
              <p class="collection-empty__title">
                Nenhuma peça corresponde aos filtros selecionados.
              </p>
              <a
                class="collection-empty__link"
                href="{{ collection.url }}"
              >
                Limpar filtros e ver todas as peças
              </a>
            {%- else -%}
              <p class="collection-empty__title">
                Esta coleção ainda não tem peças publicadas.
              </p>
              <a
                class="collection-empty__link"
                href="{{ routes.all_products_collection_url }}"
              >
                Ver o catálogo completo
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {{ paginate | default_pagination }}
    </div>
  </div>
{% endpaginate %}

{% stylesheet %}
  .collection-products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  .collection-description {
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .collection-empty {
    grid-column: 1 / -1;
  }

  .product-card__media-wrap {
    position: relative;
  }

  .product-card__media {
    position: relative;
    overflow: hidden;
  }

  .product-card__image {
    width: 100%;
    display: block;
  }

  .product-card__media--sold-out .product-card__image {
    filter: grayscale(1);
    opacity: 0.6;
  }

  .product-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    padding: 0.35rem 0.75rem;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #1a1a1a);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-card__image--alt {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (hover: hover) and (min-width: 768px) {
    .product-card__media--swap:not(.product-card__media--sold-out):hover .product-card__image--alt {
      opacity: 1;
    }
  }

  .product-card__title {
    margin: 1rem 0 0.25rem;
    font-size: 1rem;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-card__price {
    margin: 0;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}