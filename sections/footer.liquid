{% comment %}
  Seção: Rodapé
  Fase: 4 — Página inicial
  Tarefa: 4.7
  Descrição: Fecho visual da loja — navegação, contato e marca
{% endcomment %}

<footer class="footer">
  <div class="footer__container">
    <div class="footer__grid">

      <div class="footer__brand">
        {%- if section.settings.brand_title != blank -%}
          <p class="footer__logo">{{ section.settings.brand_title }}</p>
        {%- endif -%}
        {%- if section.settings.brand_text != blank -%}
          <p class="footer__brand-text">{{ section.settings.brand_text }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__column" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3 class="footer__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.menu != blank -%}
            <ul class="footer__links">
              {%- for link in linklists[block.settings.menu].links -%}
                <li>
                  <a href="{{ link.url }}" class="footer__link">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}

      <div class="footer__column">
        {%- if section.settings.contact_heading != blank -%}
          <h3 class="footer__heading">{{ section.settings.contact_heading }}</h3>
        {%- endif -%}
        {%- if section.settings.contact_email != blank -%}
          <a href="mailto:{{ section.settings.contact_email }}" class="footer__link">
            {{ section.settings.contact_email }}
          </a>
        {%- endif -%}
        {%- if section.settings.contact_text != blank -%}
          <p class="footer__contact-text">{{ section.settings.contact_text }}</p>
        {%- endif -%}
      </div>

    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ "now" | date: "%Y" }} {{ section.settings.brand_title | default: shop.name }} — Todos os direitos reservados
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "tag": "footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_title",
      "label": "Nome da marca",
      "default": "JOFA"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Frase da marca",
      "default": "Acessórios premium para cães, feitos com intenção."
    },
    {
      "type": "header",
      "content": "Contato"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Título da coluna de contato",
      "default": "Atendimento"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "E-mail de contato",
      "default": "contato@jofa.com.br"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "Texto de horário",
      "default": "<p>Resposta em até 24 horas em dias úteis.</p>"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Coluna de menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título da coluna",
          "default": "Navegação"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}