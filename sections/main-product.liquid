{% comment %}
  Página de produto — seção principal.
  Tarefa 6.1: galeria de imagens.
  Tarefa 6.2: identidade (título, coleção, preço, disponibilidade).
  Tarefa 6.3: seletor de variantes com preço dinâmico.
  Tarefa 6.4: quantidade + botão de adicionar ao carrinho.
  Tarefas 6.5 a 6.8 completam prova, serviço e continuidade.
{% endcomment %}

<div class="product-page">
  <div class="product-gallery">
    <div class="product-gallery__main">
      {% if product.media.size > 0 %}
        {% for media in product.media %}
          <div
            class="product-gallery__slide"
            id="product-slide-{{ forloop.index0 }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            {% render 'image',
              class: 'product-gallery__image',
              image: media,
              url: product.url,
              width: 1200,
              height: 1500,
              crop: 'center'
            %}
          </div>
        {% endfor %}
      {% else %}
        <div class="product-gallery__slide">
          {{ 'product-1' | placeholder_svg_tag: 'product-gallery__placeholder' }}
        </div>
      {% endif %}
    </div>

    {% if product.media.size > 1 %}
      <div class="product-gallery__thumbs" role="group" aria-label="Imagens do produto">
        {% for media in product.media %}
          <button
            type="button"
            class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
            data-slide="{{ forloop.index0 }}"
            aria-label="Ver imagem {{ forloop.index }} de {{ product.media.size }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          >
            {{ media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="product-info">
    {%- comment -%} ===== Identidade — Tarefa 6.2 ===== {%- endcomment -%}
    {% if product.collections.first %}
      <p class="product-info__collection">{{ product.collections.first.title }}</p>
    {% endif %}

    <h1 class="product-info__title">{{ product.title | escape }}</h1>

    <p
      class="product-info__price"
      data-product-price
    >
      <span class="product-info__price-value">
        {{ product.selected_or_first_available_variant.price | money }}
      </span>
      {% unless product.selected_or_first_available_variant.available %}
        <span class="product-info__badge">Esgotado</span>
      {% endunless %}
    </p>

    {%- comment -%} ===== Seletor de variantes — Tarefa 6.3 ===== {%- endcomment -%}
    {% if product.variants.size > 1 %}
      <div class="product-variants">
        <label class="product-variants__label" for="variant-select">
          {{ product.options | join: ' / ' }}
        </label>
        <select
          id="variant-select"
          class="product-variants__select"
          data-variant-select
        >
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              data-price="{{ variant.price }}"
              data-available="{{ variant.available }}"
              {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (esgotado){% endunless %}
            </option>
          {% endfor %}
        </select>
      </div>
    {% endif %}

    {%- comment -%} ===== Compra — Tarefa 6.4 ===== {%- endcomment -%}
    <form
      method="post"
      action="{{ routes.cart_add_url }}"
      class="product-purchase"
      data-product-form
    >
      <input
        type="hidden"
        name="id"
        value="{{ product.selected_or_first_available_variant.id }}"
        data-variant-input
      >
      <input type="hidden" name="form_type" value="product">
      <input type="hidden" name="utf8" value="✓">

      <div class="product-purchase__quantity">
        <label class="product-purchase__qty-label" for="quantity-input">Quantidade</label>
        <input
          type="number"
          id="quantity-input"
          name="quantity"
          value="1"
          min="1"
          max="99"
          inputmode="numeric"
          class="product-purchase__qty-input"
        >
      </div>

      <button
        type="submit"
        class="product-purchase__button"
        {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
      >
        {% if product.selected_or_first_available_variant.available %}
          Adicionar ao carrinho
        {% else %}
          Esgotado
        {% endif %}
      </button>
    </form>
    {%- comment -%} ===== Fim da compra — prova material entra na 6.5 ===== {%- endcomment -%}
  </div>
</div>

{% javascript %}
(function () {
  'use strict';

  var gallery = document.querySelector('.product-gallery');
  if (gallery) {
    var slides = gallery.querySelectorAll('.product-gallery__slide');
    var thumbs = gallery.querySelectorAll('.product-gallery__thumb');

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var index = thumb.getAttribute('data-slide');

        slides.forEach(function (slide) {
          slide.hidden = slide.id !== 'product-slide-' + index;
        });

        thumbs.forEach(function (t) {
          var isActive = t === thumb;
          t.classList.toggle('is-active', isActive);
          if (isActive) {
            t.setAttribute('aria-current', 'true');
          } else {
            t.removeAttribute('aria-current');
          }
        });
      });
    });
  }

  var select = document.querySelector('[data-variant-select]');
  var priceEl = document.querySelector('[data-product-price]');
  var variantInput = document.querySelector('[data-variant-input]');
  var submitButton = document.querySelector('[data-product-form] [type="submit"]');

  if (!select || !priceEl || !variantInput) return;

  function formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }

  select.addEventListener('change', function () {
    var option = select.options[select.selectedIndex];
    var price = option.getAttribute('data-price');
    var available = option.getAttribute('data-available') === 'true';

    variantInput.value = select.value;

    var priceValue = priceEl.querySelector('.product-info__price-value');
    var badge = priceEl.querySelector('.product-info__badge');

    priceValue.textContent = formatMoney(parseInt(price, 10));

    if (badge) badge.remove();

    if (!available) {
      badge = document.createElement('span');
      badge.className = 'product-info__badge';
      badge.textContent = 'Esgotado';
      priceEl.appendChild(badge);
    }

    if (submitButton) {
      submitButton.disabled = !available;
      submitButton.textContent = available ? 'Adicionar ao carrinho' : 'Esgotado';
    }

    var url = new URL(window.location);
    url.searchParams.set('variant', select.value);
    window.history.replaceState({}, '', url);
  });
})();
{% endjavascript %}

{% stylesheet %}
  .product-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: var(--max-width, 80rem);
    margin: 0 auto;
    padding: 2rem var(--spacing-md, 2rem) 4rem;
  }

  .product-gallery__main {
    position: relative;
    overflow: hidden;
  }

  .product-gallery__slide {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--color-bg-alt, #e8e0d5);
  }

  .product-gallery__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .product-gallery__thumbs {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .product-gallery__thumb {
    width: 72px;
    height: 90px;
    padding: 0;
    border: 1px solid transparent;
    background: none;
    cursor: pointer;
    overflow: hidden;
  }

  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-gallery__thumb.is-active {
    border-color: var(--color-foreground, #1a1a1a);
  }

  .product-gallery__thumb:focus-visible {
    outline: 2px solid var(--color-foreground, #1a1a1a);
    outline-offset: 2px;
  }

  /* ===== Identidade — Tarefa 6.2 ===== */
  .product-info__collection {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .product-info__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading, Georgia, 'Times New Roman', serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .product-info__price {
    margin: 0 0 1.5rem;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .product-info__badge {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    background: var(--color-foreground, #1a1a1a);
    color: var(--color-background, #fff);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ===== Seletor de variantes — Tarefa 6.3 ===== */
  .product-variants {
    margin: 0 0 1.5rem;
  }

  .product-variants__label {
    display: block;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .product-variants__select {
    width: 100%;
    max-width: 20rem;
    min-height: 44px;
    padding: 0.5rem;
    font-size: 1rem;
    background: var(--color-background, #fff);
    border: 1px solid var(--color-foreground, #1a1a1a);
  }

  /* ===== Compra — Tarefa 6.4 ===== */
  .product-purchase {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }

  .product-purchase__quantity {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .product-purchase__qty-label {
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product-purchase__qty-input {
    width: 4.5rem;
    min-height: 44px;
    padding: 0.5rem;
    font-size: 1rem;
    text-align: center;
    border: 1px solid var(--color-foreground, #1a1a1a);
    background: var(--color-background, #fff);
  }

  .product-purchase__button {
    min-height: 48px;
    padding: 0.85rem 2rem;
    cursor: pointer;
    background: var(--color-foreground, #1a1a1a);
    color: var(--color-background, #fff);
    border: 1px solid var(--color-foreground, #1a1a1a);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: opacity 0.2s ease;
  }

  .product-purchase__button:hover:not(:disabled) {
    opacity: 0.85;
  }

  .product-purchase__button:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }

  @media (min-width: 768px) {
    .product-page {
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
    }

    .product-gallery__thumb {
      width: 80px;
      height: 100px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produto principal",
  "settings": []
}
{% endschema %}