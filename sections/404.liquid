{% comment %}
  Seção: Hero principal
  Fase: 4 — Página inicial
  Tarefa: 4.1
  Descrição: Hero de tela cheia com imagem, título, texto de apoio e CTAs
{% endcomment %}

<section class="hero" id="hero-{{ section.id }}">
  <div class="hero__image-wrapper">
    {%- if section.settings.hero_image != blank -%}
      <img
        src="{{ section.settings.hero_image | image_url: width: 2400 }}"
        srcset="
          {{ section.settings.hero_image | image_url: width: 600 }} 600w,
          {{ section.settings.hero_image | image_url: width: 900 }} 900w,
          {{ section.settings.hero_image | image_url: width: 1200 }} 1200w,
          {{ section.settings.hero_image | image_url: width: 1800 }} 1800w,
          {{ section.settings.hero_image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt="{{ section.settings.hero_image.alt | escape }}"
        class="hero__image"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.hero_image.width }}"
        height="{{ section.settings.hero_image.height }}"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__image hero__image--placeholder' }}
    {%- endif -%}
    <div class="hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="hero__content">
    {%- if section.settings.hero_title != blank -%}
      <h1 class="hero__title">{{ section.settings.hero_title }}</h1>
    {%- endif -%}

    {%- if section.settings.hero_text != blank -%}
      <p class="hero__text">{{ section.settings.hero_text }}</p>
    {%- endif -%}

    {%- if section.settings.hero_button_label != blank and section.settings.hero_button_link != blank -%}
      <div class="hero__actions">
        <a
          href="{{ section.settings.hero_button_link }}"
          class="hero__button hero__button--primary"
        >
          {{ section.settings.hero_button_label }}
        </a>

        {%- if section.settings.hero_button_secondary_label != blank and section.settings.hero_button_secondary_link != blank -%}
          <a
            href="{{ section.settings.hero_button_secondary_link }}"
            class="hero__button hero__button--secondary"
          >
            {{ section.settings.hero_button_secondary_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero principal",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagem principal"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Título",
      "default": "Peças autorais para o seu melhor amigo"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Texto de apoio",
      "default": "Acessórios premium feitos com intenção, materiais selecionados e acabamento que dura."
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "Texto do botão principal",
      "default": "Comprar"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Link do botão principal"
    },
    {
      "type": "text",
      "id": "hero_button_secondary_label",
      "label": "Texto do botão secundário (opcional)",
      "default": "Ver coleções"
    },
    {
      "type": "url",
      "id": "hero_button_secondary_link",
      "label": "Link do botão secundário (opcional)"
    }
  ],
  "presets": [
    {
      "name": "Hero principal"
    }
  ]
}
{% endschema %}