{% comment %}
  Card reutilizável de produto.

  Uso:
  {% render 'product-card', product: product %}

  Dados exibidos:
  - Imagem principal
  - Segunda imagem (hover, desktop)
  - Selo de indisponibilidade (quando esgotado)
  - Nome do produto
  - Preço
  - Contador de variantes (quando houver mais de uma)
  - Link para a página do produto
{% endcomment %}

{% if product != blank %}
  {% assign second_image = product.images[1] %}
  {% assign variant_count = product.variants | size %}

  <article class="product-card">
    <div class="product-card__media-wrap">
      <a
        class="product-card__link"
        href="{{ product.url }}"
        aria-label="{{ product.title | escape }}"
      >
        <div class="product-card__media{% unless product.available %} product-card__media--sold-out{% endunless %}{% if second_image %} product-card__media--swap{% endif %}">
          {% if product.featured_image %}
            {% render 'image',
              class: 'product-card__image product-card__image--main',
              image: product.featured_image,
              url: product.url,
              width: 400,
              height: 400,
              crop: 'center'
            %}
          {% endif %}

          {% if second_image %}
            {% render 'image',
              class: 'product-card__image product-card__image--alt',
              image: second_image,
              url: product.url,
              width: 400,
              height: 400,
              crop: 'center'
            %}
          {% endif %}
        </div>
      </a>

      {% unless product.available %}
        <span class="product-card__badge" aria-hidden="true">Esgotado</span>
      {% endunless %}
    </div>

    <div class="product-card__content">
      <h2 class="product-card__title">
        <a href="{{ product.url }}">{{ product.title | escape }}</a>
      </h2>

      <p class="product-card__price">
        {{ product.price | money }}
      </p>

      {% if variant_count > 1 %}
        <p class="product-card__variants">
          {{ variant_count }} opções
        </p>
      {% endif %}
    </div>
  </article>
{% endif %}