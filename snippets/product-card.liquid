{% comment %}
  Card reutilizável de produto.

  Uso:
  {% render 'product-card', product: product %}

  Dados exibidos:
  - Imagem principal
  - Segunda imagem (hover, desktop)
  - Nome do produto
  - Preço
  - Link para a página do produto
{% endcomment %}

{% if product != blank %}
  {% assign second_image = product.images[1] %}

  <article class="product-card">
    <a
      class="product-card__link"
      href="{{ product.url }}"
      aria-label="{{ product.title | escape }}"
    >
      <div class="product-card__media{% if second_image %} product-card__media--swap{% endif %}">
        {% if product.featured_image %}
          {% render 'image',
            class: 'product-card__image product-card__image--main',
            image: product.featured_image,
            url: product.url,
            width: 400,
            height: 400,
            crop: 'center'
          %}
        {% endif %}

        {% if second_image %}
          {% render 'image',
            class: 'product-card__image product-card__image--alt',
            image: second_image,
            url: product.url,
            width: 400,
            height: 400,
            crop: 'center'
          %}
        {% endif %}
      </div>

      <div class="product-card__content">
        <h2 class="product-card__title">
          {{ product.title | escape }}
        </h2>

        <p class="product-card__price">
          {{ product.price | money }}
        </p>
      </div>
    </a>
  </article>
{% endif %}